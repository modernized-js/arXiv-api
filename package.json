{
  "name": "@modernized/arxiv-api",
  "version": "1.0.1",
  "description": "node wrapper for arXiv api. typescript version",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest -u ./src/index.test.ts",
    "test:coverage": "jest ./dist/index.test.js --coverage",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '{*,src/**/*}.{js,ts}'",
    "lint": "eslint src",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modernized-js/arXiv-api.git"
  },
  "keywords": [
    "arxiv",
    "node",
    "javascript"
  ],
  "author": "elior avraham",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/modernized-js/arXiv-api"
  },
  "homepage": "https://github.com/modernized-js/arXiv-api#readme",
  "dependencies": {
    "brace-expansion": "^5.0.12",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-node": "11.1.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "directories": {
    "dist": "dist"
  },
  "engines": {
    "node": ">=8.10.0"
  },
  "resolutions": {
    "brace-expansion": "^5.0.8"
  }
}
